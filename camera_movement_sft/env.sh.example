#!/bin/bash
# ============================================================================
# env.sh.example — Template for user-specific environment configuration.
# ============================================================================
# Copy this file to env.sh and fill in your own values:
#   cp env.sh.example env.sh
# env.sh is git-ignored and will never be committed.
# ============================================================================

# --------------------------------
# Network proxy
# (leave empty to disable proxy)
# --------------------------------
export http_proxy=
export https_proxy=

# --------------------------------
# HuggingFace
# --------------------------------
export HF_HOME=""           # e.g. /home/yourname/.cache/huggingface
export HF_TOKEN=""          # your HuggingFace access token
export USE_HF="${USE_HF:-1}"   # 1 = use HF hub; 0 = fall back to ModelScope

# --------------------------------
# WandB
# --------------------------------
export WANDB_API_KEY=""     # your WandB API key (leave empty to disable WandB)
export WANDB_PROJECT="${WANDB_PROJECT:-camera-movement}"

# --------------------------------
# VGGT local repo paths
# (used by vggt_feature_extractor.py)
# --------------------------------
export VGGT_REPO=""         # local path to the VGGT repo
export VGGT_OMEGA_REPO=""   # local path to the VGGT-Omega repo

# --------------------------------
# Default data / cache paths
# (all overridable via env at call site)
# --------------------------------
# Pre-extracted VGGT feature cache directory.
export VGGT_CACHE_DIR="${VGGT_CACHE_DIR:-}"

# Training dataset path.
export DATASET_PATH="${DATASET_PATH:-}"

# Benchmark test set path (CamChoreo annotations.jsonl).
# Leave empty to use the in-repo default: camera_movement_sft/data/CamChoreo/annotations.jsonl
export BENCHMARK_PATH="${BENCHMARK_PATH:-}"

# Training output root directory.
export OUTPUT_ROOT="${OUTPUT_ROOT:-output}"
